// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

model User {
  id       Int     @id @default(autoincrement()) @map("user_id")
  name     String  @db.VarChar(150)
  username String  @unique @db.VarChar(100)
  email    String? @unique @db.VarChar(191)
  password String  @db.VarChar(255)

  isActive Boolean @default(true) @map("is_active")

  notifications Notification[]
  auditLogs     AuditLog[]

  roles UserRole[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("users")
}

model Role {
  id          Int     @id @default(autoincrement()) @map("role_id")
  name        String  @unique @map("role_name") @db.VarChar(100)
  description String? @db.Text

  users UserRole[]

  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  permissions RolePermission[]

  @@map("roles")
}

model UserRole {
  userId Int @map("user_id")
  roleId Int @map("role_id")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  assignedAt DateTime @default(now()) @map("assigned_at")

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model Permission {
  id          Int              @id @default(autoincrement()) @map("permission_id")
  code        String           @unique
  name        String           @unique @db.VarChar(100)
  description String?          @db.Text
  roles       RolePermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("permissions")
}

model RolePermission {
  roleId       Int
  permissionId Int

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

enum status_subscription {
  ACTIVE
  PAUSED
  CANCELLED
  TRIAL
}

enum billing_cycle {
  MONTHLY
  YEARLY
}

enum BillingStatus {
  SCHEDULED
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum CardStatus {
  ACTIVE
  INACTIVE
  BLOCKED
  EXPIRED
}

enum StatementStatus {
  OPEN
  CLOSED
  PARTIALLY_PAID
  PAID
  OVERDUE
}

enum NotificationType {
  BILLING_REMINDER
  PAYMENT_DUE
  PAYMENT_SUCCESS
  PAYMENT_FAILED
  BUDGET_WARNING
  SUBSCRIPTION_EXPIRING
  CARD_STATEMENT
  SYSTEM
}

enum BudgetPeriod {
  MONTHLY
  YEARLY
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  PAYMENT
  CANCEL
  GENERATE
}

model SubscriptionCategory {
  id          Int     @id @default(autoincrement())
  name        String?  @unique @db.VarChar(100)
  description String? @db.Text
  color       String? @db.VarChar(20)
  icon        String? @db.VarChar(100)

  isActive Boolean? @default(true)

  subscriptions Subscription[]
  budgets       Budget[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("subscription_categories")
}

model Subscription {
  id Int @id @default(autoincrement()) @map("subscription_id")

  subscriptionName String @map("subscription_name") @db.VarChar(100)

  amount       Decimal?      @db.Decimal(10, 2)
  billingCycle billing_cycle @map("billing_cycle")
  nextBilling  DateTime?     @map("next_billing") @db.Date

  paymentCard String? @map("payment_card") @db.VarChar(100)
  category    String? @db.VarChar(100)

  status status_subscription

  creditCardId Int @map("credit_card")

  card CreditCard @relation(fields: [creditCardId], references: [id], onDelete: Restrict)

  // NEW FIELDS
  description String? @db.Text

  currencyCode String @default("PHP") @db.VarChar(3)

  startDate DateTime? @db.Date
  endDate   DateTime? @db.Date

  anchorDay Int?

  autoRenew Boolean @default(true)

  website String? @db.VarChar(255)

  categoryId Int?

  subscriptionCategory SubscriptionCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  billings      SubscriptionBilling[]
  payments      SubscriptionPayment[]
  priceHistory  SubscriptionPriceHistory[]
  notifications Notification[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, nextBilling])
  @@index([creditCardId])
  @@index([categoryId])
  @@map("subscription")
}

model SubscriptionBilling {
  id Int @id @default(autoincrement())

  subscriptionId Int

  dueDate DateTime @db.Date

  amount Decimal @db.Decimal(15, 2)

  currencyCode String @default("PHP") @db.VarChar(3)

  status BillingStatus @default(SCHEDULED)

  paidAmount Decimal @default(0) @db.Decimal(15, 2)

  remarks String? @db.Text

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)

  payments SubscriptionPayment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([subscriptionId, dueDate])
  @@index([dueDate, status])
  @@map("subscription_billings")
}

model SubscriptionPayment {
  id Int @id @default(autoincrement())

  subscriptionId Int
  billingId      Int

  amount Decimal @db.Decimal(15, 2)

  currencyCode String @default("PHP") @db.VarChar(3)

  paymentDate DateTime? @db.DateTime(3)

  status PaymentStatus @default(PENDING)

  referenceNumber String? @db.VarChar(100)

  idempotencyKey String? @unique @db.VarChar(100)

  remarks String? @db.Text

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)

  billing SubscriptionBilling @relation(fields: [billingId], references: [id], onDelete: Restrict)

  cardCharge CardCharge?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([subscriptionId])
  @@index([billingId])
  @@index([status, paymentDate])
  @@map("subscription_payments")
}

model CardCharge {
  id Int @id @default(autoincrement())

  creditCardId Int

  subscriptionPaymentId Int @unique

  statementId Int?

  amount Decimal @db.Decimal(15, 2)

  currencyCode String @db.VarChar(3)

  // Amount posted in the card's currency
  postedAmount Decimal @db.Decimal(15, 2)

  exchangeRate Decimal @default(1) @db.Decimal(20, 8)

  transactionDate DateTime  @db.Date
  postingDate     DateTime? @db.Date

  description String? @db.VarChar(255)

  card CreditCard @relation(fields: [creditCardId], references: [id], onDelete: Restrict)

  subscriptionPayment SubscriptionPayment @relation(fields: [subscriptionPaymentId], references: [id], onDelete: Restrict)

  statement CardStatement? @relation(fields: [statementId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([creditCardId, transactionDate])
  @@index([statementId])
  @@map("card_charges")
}

// ==========================================
// CREDIT CARD STATEMENTS
// ==========================================

model CardStatement {
  id Int @id @default(autoincrement())

  creditCardId Int

  periodStart DateTime @db.Date
  periodEnd   DateTime @db.Date

  statementDate DateTime @db.Date
  dueDate       DateTime @db.Date

  openingBalance Decimal @default(0) @db.Decimal(15, 2)

  totalCharges Decimal @default(0) @db.Decimal(15, 2)

  totalPayments Decimal @default(0) @db.Decimal(15, 2)

  closingBalance Decimal @default(0) @db.Decimal(15, 2)

  minimumPayment Decimal @default(0) @db.Decimal(15, 2)

  currencyCode String @default("PHP") @db.VarChar(3)

  status StatementStatus @default(OPEN)

  card CreditCard @relation(fields: [creditCardId], references: [id], onDelete: Restrict)

  charges  CardCharge[]
  payments CardPayment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([creditCardId, periodStart, periodEnd])
  @@index([dueDate, status])
  @@map("card_statements")
}

// ==========================================
// CREDIT CARD BANK PAYMENTS
// ==========================================

model CardPayment {
  id Int @id @default(autoincrement())

  creditCardId Int

  statementId Int?

  amount Decimal @db.Decimal(15, 2)

  currencyCode String @default("PHP") @db.VarChar(3)

  paymentDate DateTime @db.Date

  referenceNumber String? @db.VarChar(100)

  remarks String? @db.Text

  card CreditCard @relation(fields: [creditCardId], references: [id], onDelete: Restrict)

  statement CardStatement? @relation(fields: [statementId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([creditCardId, paymentDate])
  @@index([statementId])
  @@map("card_payments")
}

// ==========================================
// SUBSCRIPTION PRICE HISTORY
// ==========================================

model SubscriptionPriceHistory {
  id Int @id @default(autoincrement())

  subscriptionId Int

  oldAmount Decimal? @db.Decimal(15, 2)
  newAmount Decimal  @db.Decimal(15, 2)

  currencyCode String @default("PHP") @db.VarChar(3)

  effectiveDate DateTime @db.Date

  reason String? @db.VarChar(255)

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())

  @@index([subscriptionId, effectiveDate])
  @@map("subscription_price_history")
}

// ==========================================
// BUDGET MANAGEMENT
// ==========================================

model Budget {
  id Int @id @default(autoincrement())

  name String @db.VarChar(150)

  amount Decimal @db.Decimal(15, 2)

  currencyCode String @default("PHP") @db.VarChar(3)

  period BudgetPeriod @default(MONTHLY)

  categoryId Int?

  category SubscriptionCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  alertThreshold Int @default(80)

  isActive Boolean @default(true)

  startDate DateTime  @db.Date
  endDate   DateTime? @db.Date

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([period, isActive])
  @@map("budgets")
}

// ==========================================
// NOTIFICATIONS
// ==========================================

model Notification {
  id Int @id @default(autoincrement())

  userId Int

  subscriptionId Int?

  type NotificationType

  title String @db.VarChar(200)

  message String @db.Text

  isRead Boolean @default(false)

  scheduledFor DateTime?

  sentAt DateTime?
  readAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([userId, isRead])
  @@index([scheduledFor])
  @@map("notifications")
}

// ==========================================
// EXCHANGE RATES
// ==========================================

model ExchangeRate {
  id Int @id @default(autoincrement())

  fromCurrency String @db.VarChar(3)
  toCurrency   String @db.VarChar(3)

  rate Decimal @db.Decimal(20, 8)

  effectiveDate DateTime @db.Date

  source String? @db.VarChar(100)

  createdAt DateTime @default(now())

  @@unique([fromCurrency, toCurrency, effectiveDate])
  @@index([effectiveDate])
  @@map("exchange_rates")
}

// ==========================================
// AUDIT LOGS
// ==========================================

model AuditLog {
  id Int @id @default(autoincrement())

  userId Int?

  action AuditAction

  module String @db.VarChar(100)

  referenceId Int?

  description String? @db.Text

  oldValues Json?
  newValues Json?

  ipAddress String? @db.VarChar(45)
  userAgent String? @db.Text

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([module, referenceId])
  @@index([userId])
  @@index([createdAt])
  @@map("audit_logs")
}

model CreditCard {
  id              Int     @id @default(autoincrement()) @map("card_id")
  bank            String  @db.VarChar(100)
  last_four_digit Int
  network         String  @db.VarChar(100)
  nickname        String? @db.VarChar(100)

  // NEW FIELDS
  creditLimit  Decimal @default(0) @db.Decimal(15, 2)
  currencyCode String  @default("PHP") @db.VarChar(3)

  statementDay Int?
  dueDay       Int?

  status CardStatus @default(ACTIVE)

  expiryMonth Int?
  expiryYear  Int?

  subscriptions Subscription[]
  charges       CardCharge[]
  statements    CardStatement[]
  cardPayments  CardPayment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("card")
}


